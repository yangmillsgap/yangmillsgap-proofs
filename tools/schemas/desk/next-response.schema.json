{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.massgap.invalid/desk/next-response.schema.json",
  "title": "DeskNextResponse",
  "description": "200 response of GET /desk/next. Either a step with its lease, or empty when nothing matches the filters right now (retry after retry_after_s). Errors use the error envelope. The first call for a handle that has no client key carries client_key once; send it as Authorization: Bearer <client_key> on every later next, beat and release for that handle.",
  "oneOf": [
    {
      "title": "DeskNextLeased",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "empty",
        "lease",
        "step"
      ],
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "empty": {
          "type": "boolean",
          "const": false
        },
        "lease": {
          "$ref": "../common.schema.json#/$defs/Lease"
        },
        "step": {
          "$ref": "../common.schema.json#/$defs/Step"
        },
        "client_key": {
          "type": "string",
          "pattern": "^ck-[0-9a-f]{32}$",
          "description": "Returned once, on the call that claimed the handle. Keep it secret; the desk stores only its SHA-256."
        }
      }
    },
    {
      "title": "DeskNextEmpty",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "empty",
        "reason",
        "retry_after_s"
      ],
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "empty": {
          "type": "boolean",
          "const": true
        },
        "reason": {
          "type": "string",
          "enum": [
            "no_open_steps",
            "no_match_for_filters",
            "join_closed"
          ]
        },
        "retry_after_s": {
          "type": "integer",
          "minimum": 1
        },
        "client_key": {
          "type": "string",
          "pattern": "^ck-[0-9a-f]{32}$",
          "description": "Returned once, on the call that claimed the handle. Keep it secret; the desk stores only its SHA-256."
        }
      }
    }
  ]
}
