{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.massgap.invalid/desk/beat-response.schema.json",
  "title": "DeskBeatResponse",
  "description": "200 response of POST /desk/beat.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "lease_id",
    "state",
    "last_beat_at",
    "expires_at"
  ],
  "properties": {
    "ok": {
      "type": "boolean",
      "const": true
    },
    "lease_id": {
      "$ref": "../common.schema.json#/$defs/LeaseId"
    },
    "state": {
      "type": "string",
      "const": "live"
    },
    "last_beat_at": {
      "$ref": "../common.schema.json#/$defs/Timestamp"
    },
    "expires_at": {
      "$ref": "../common.schema.json#/$defs/Timestamp"
    }
  }
}
